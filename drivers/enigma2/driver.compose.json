{
  "name": {
    "en": "enigma2"
  },
  "class": "tv",
  "capabilities": [
    "speaker_artist",
    "speaker_track",
    "speaker_position",
    "speaker_duration",
    "channel_down",
    "channel_up",
    "speaker_next",
    "speaker_playing",
    "speaker_prev",
    "volume_set",
    "onoff",
    "volume_down",
    "volume_mute",
    "volume_up"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"
  },
  "settings": [
    {
      "id": "IPAddress",
      "type": "text",
      "label": {
        "en": "IP Address"
      },
      "value": "192.168.1.10",
      "hint": {
        "en": "Enter the IP address of your Enigma2 receiver."
      }
    },
    {
      "id": "Port",
      "type": "number",
      "label": {
        "en": "Port"
      },
      "value": 443,
      "hint": {
        "en": "Enter the WebIF port (e.g., 443 for HTTPS or 80 for HTTP)."
      }
    },
    {
      "id": "PollInterval",
      "type": "number",
      "label": {
        "en": "Poll interval (seconds)"
      },
      "value": 5,
      "hint": {
        "en": "Device state check interval. Minimum 5, maximum 60."
      }
    },
    {
      "id": "Username",
      "type": "text",
      "label": {
        "en": "Username"
      },
      "value": "",
      "hint": {
        "en": "Enter the username for your Enigma2 receiver, if applicable."
      }
    },
    {
      "id": "Password",
      "type": "password",
      "label": {
        "en": "Password"
      },
      "value": "",
      "hint": {
        "en": "Enter the password for your Enigma2 receiver, if applicable."
      }
    },
    {
      "id": "TextEncoding",
      "type": "dropdown",
      "label": {
        "en": "Text encoding"
      },
      "value": "auto",
      "hint": {
        "en": "Use auto unless channel titles show corrupted characters."
      },
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto (recommended)"
          }
        },
        {
          "id": "utf-8",
          "label": {
            "en": "UTF-8"
          }
        },
        {
          "id": "windows-1250",
          "label": {
            "en": "Windows-1250 (Central European)"
          }
        },
        {
          "id": "iso-8859-2",
          "label": {
            "en": "ISO-8859-2 (Central European)"
          }
        },
        {
          "id": "windows-1251",
          "label": {
            "en": "Windows-1251 (Cyrillic)"
          }
        },
        {
          "id": "iso-8859-7",
          "label": {
            "en": "ISO-8859-7 (Greek)"
          }
        },
        {
          "id": "windows-1254",
          "label": {
            "en": "Windows-1254 (Turkish)"
          }
        },
        {
          "id": "latin1",
          "label": {
            "en": "ISO-8859-1 (Western European)"
          }
        }
      ]
    }
  ],
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "get_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
