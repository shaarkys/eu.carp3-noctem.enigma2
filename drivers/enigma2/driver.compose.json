{
  "name": {
    "en": "enigma2"
  },
  "class": "tv",
  "capabilities": [
    "speaker_artist",
    "speaker_track",
    "speaker_position",
    "speaker_duration",
    "channel_down",
    "channel_up",
    "speaker_next",
    "speaker_playing",
    "speaker_prev",
    "volume_set",
    "onoff",
    "volume_down",
    "volume_mute",
    "volume_up"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"
  },
  "settings": [
    {
      "id": "IPAddress",
      "type": "text",
      "label": {
        "en": "IP Address"
      },
      "value": "192.168.1.10",
      "hint": {
        "en": "Enter the IP address of your Enigma2 receiver."
      }
    },
    {
      "id": "Port",
      "type": "number",
      "label": {
        "en": "Port"
      },
      "value": 443,
      "hint": {
        "en": "Enter the WebIF port (e.g., 443 for HTTPS or 80 for HTTP)."
      },
      "min": 1,
      "max": 65535,
      "step": 1
    },
    {
      "id": "Protocol",
      "type": "dropdown",
      "value": "auto",
      "label": {
        "en": "Connection protocol",
        "de": "Verbindungsprotokoll",
        "nl": "Verbindingsprotocol"
      },
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Automatic (HTTPS on port 443)",
            "de": "Automatisch (HTTPS auf Port 443)",
            "nl": "Automatisch (HTTPS op poort 443)"
          }
        },
        {
          "id": "http",
          "label": {
            "en": "HTTP"
          }
        },
        {
          "id": "https",
          "label": {
            "en": "HTTPS"
          }
        }
      ]
    },
    {
      "id": "AllowSelfSigned",
      "type": "checkbox",
      "value": true,
      "label": {
        "en": "Allow untrusted certificates",
        "de": "Nicht vertrauenswürdige Zertifikate zulassen",
        "nl": "Niet-vertrouwde certificaten toestaan"
      },
      "hint": {
        "en": "Disable to verify the HTTPS certificate. Enabled by default for compatibility with existing receivers.",
        "de": "Deaktivieren, um das HTTPS-Zertifikat zu prüfen. Für bestehende Receiver standardmäßig aktiviert.",
        "nl": "Schakel uit om het HTTPS-certificaat te controleren. Standaard aan voor bestaande ontvangers."
      }
    },
    {
      "id": "PollInterval",
      "type": "number",
      "label": {
        "en": "Poll interval (seconds)"
      },
      "value": 5,
      "hint": {
        "en": "Device state check interval. Minimum 5, maximum 60."
      },
      "min": 5,
      "max": 60,
      "step": 1
    },
    {
      "id": "Username",
      "type": "text",
      "label": {
        "en": "Username"
      },
      "value": "",
      "hint": {
        "en": "Enter the username for your Enigma2 receiver, if applicable."
      }
    },
    {
      "id": "Password",
      "type": "password",
      "label": {
        "en": "Password"
      },
      "value": "",
      "hint": {
        "en": "Enter the password for your Enigma2 receiver, if applicable."
      }
    }
  ],
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "get_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
